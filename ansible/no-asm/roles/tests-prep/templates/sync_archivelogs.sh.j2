#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
[ -f "${SCRIPT_DIR}/lib_oracle_common.sh" ] || { echo "[CRITICAL] Missing ${SCRIPT_DIR}/lib_oracle_common.sh" >&2; exit 1; }
# shellcheck source=/home/oracle/scripts/lib_oracle_common.sh
source "${SCRIPT_DIR}/lib_oracle_common.sh"

rotate_current_redolog() {
    log_info "Forcing rotation of current Online Redo Log..."
    run_sql_quiet "db_lifecycle_op.sql" "ARCHIVE_LOG_CURRENT"
}

sync_fra_to_s3() {
    log_info "Syncing archived logs from ${FRA_DEST} to ${S3_ARCHIVELOG_URI}..."
    aws s3 sync "$FRA_DEST" "$S3_ARCHIVELOG_URI" \
        --exclude "*" \
        --include "*.arc" \
        --include "*.dbf" \
        --include "*.log" \
        --only-show-errors
}

purge_local_fra() {
    log_info "Purging expired and obsolete archived logs from local FRA..."
    rman target / cmdfile="${SQL_DIR}/purge_fra_archivelogs.rcv" </dev/null >/dev/null
}

main() {
    acquire_lock "sync_archivelogs"
    load_environment
    validate_prerequisites sqlplus rman aws
    assert_dir_exists "$FRA_DEST"
    rotate_current_redolog
    sync_fra_to_s3
    purge_local_fra
    log_info "Archived log synchronization completed successfully."
}

main "$@"
