#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
[ -f "${SCRIPT_DIR}/lib_oracle_common.sh" ] || { echo "[CRITICAL] Missing ${SCRIPT_DIR}/lib_oracle_common.sh" >&2; exit 1; }
# shellcheck source=/home/oracle/scripts/lib_oracle_common.sh
source "${SCRIPT_DIR}/lib_oracle_common.sh"

usage() {
    cat <<EOF "$0") $(basename <command Usage:> [args]

Commands (Dispatcher):
  init                                 Validate /u05../u07 layout and initialize TS_PITR_CANARY in TEST1PDB..TEST3PDB
  pulse [cycles=60] [interval_sec=5]   Generate SHA-256 ledger transactions, force CHECKPOINT, and sync Ground Truth to S3
  inspect [row_limit=5]                Display live preview of the latest SHA-256 chain links across TEST1PDB..TEST3PDB
  verify "<YYYY-MM-DD HH24:MI:SS>"     Verify cryptographic PITR consistency across all 3 PDBs against target UTC timestamp
EOF
    exit 1
}

assert_pdb_topology() {
    local pdb_name="$1"
    local expected_dir="$2"

    assert_dir_exists "$expected_dir"

    local check_result clean_line open_mode matching_files
    check_result=$(run_sql_output "check_pdb_topology.sql" "$pdb_name" "$expected_dir")
    clean_line=$(echo "$check_result" | grep "^TOPO_CHECK|" | tr -d '[:space:]')
    [ -n "$clean_line" ] || die "Container ${pdb_name} was not found in v\$pdbs."

    open_mode=$(echo "$clean_line" | cut -d'|' -f2)
    matching_files=$(echo "$clean_line" | cut -d'|' -f3)

    [ "$open_mode" = "READWRITE" ] || die "Container ${pdb_name} is not in READ WRITE mode (current state: ${open_mode})."
    [ "$matching_files" -gt 0 ] || die "Storage topology mismatch: datafiles for ${pdb_name} are not located in ${expected_dir}."
}

init_single_pdb() {
    local pdb_name="$1"
    local dbf_dir="$2"

    assert_pdb_topology "$pdb_name" "$dbf_dir"
    log_info "[${pdb_name}] Topology verified (${dbf_dir}). Executing init_pitr_pdb.sql..."
    run_sql_quiet "init_pitr_pdb.sql" "$pdb_name" "$dbf_dir"
    log_info "[${pdb_name}] Initialization complete: ${dbf_dir}/pitr_canary01.dbf, ledger table, and PL/SQL procedure are VALID."
}

cmd_init() {
    acquire_lock "pitr_ctl"
    local pdb_name
    for pdb_name in "${PDB_LIST[@]}"; do
        init_single_pdb "$pdb_name" "${PDB_STORAGE_MAP[$pdb_name]}"
    done
    : > "$GROUND_TRUTH_LOG"
    log_info "All PDBs (${PDB_LIST[*]}) initialized successfully. Ground truth log reset: ${GROUND_TRUTH_LOG}"
}

record_beat_in_pdb() {
    local pdb_name="$1"
    local beat_output
    beat_output=$(run_sql_output "record_pitr_beat.sql" "$pdb_name")
    echo "$beat_output" | grep "^BEAT_OK|" | tee -a "$GROUND_TRUTH_LOG"
}

cmd_pulse() {
    acquire_lock "pitr_pulse"
    local cycles="${1:-60}"
    local interval="${2:-5}"
    [[ "$cycles" =~ ^[0-9]+$ ]] || die "Cycles parameter must be a positive integer."
    [[ "$interval" =~ ^[0-9]+$ ]] || die "Interval parameter must be a positive integer."

    local i pdb_name
    log_info "Starting PITR Heartbeat generator for [${PDB_LIST[*]}]: cycles=${cycles}, interval=${interval}s."
    for ((i = 1; i <= cycles; i++)); do
        for pdb_name in "${PDB_LIST[@]}"; do
            record_beat_in_pdb "$pdb_name"
        done

        if (( i % 3 == 0 )); then
            run_sql_quiet "db_lifecycle_op.sql" "CHECKPOINT"
        fi

        if (( i % 10 == 0 )); then
            log_info "Cycle ${i}/${cycles}: Rotating current Redo Log and syncing Ground Truth log to S3..."
            run_sql_quiet "db_lifecycle_op.sql" "ARCHIVE_LOG_CURRENT"
            aws s3 cp "$GROUND_TRUTH_LOG" "$S3_AUDIT_URI" --only-show-errors
        fi

        sleep "$interval"
    done

    aws s3 cp "$GROUND_TRUTH_LOG" "$S3_AUDIT_URI" --only-show-errors
    log_info "Heartbeat generator completed. Ground truth log uploaded to ${S3_AUDIT_URI}"
}

cmd_inspect() {
    local row_limit="${1:-5}"
    [[ "$row_limit" =~ ^[0-9]+$ ]] || die "Row limit must be a positive integer."

    local pdb_name
    for pdb_name in "${PDB_LIST[@]}"; do
        assert_pdb_topology "$pdb_name" "${PDB_STORAGE_MAP[$pdb_name]}"
        log_info "=== Inspecting latest ${row_limit} SHA-256 chain links in ${pdb_name} (${PDB_STORAGE_MAP[$pdb_name]}) ==="
        run_sql_output "inspect_pitr_pdb.sql" "$pdb_name" "$row_limit"
    done
}

verify_single_pdb() {
    local pdb_name="$1"
    local expected_dir="$2"
    local target_utc="$3"

    assert_pdb_topology "$pdb_name" "$expected_dir"

    local report_output clean_line
    report_output=$(run_sql_output "verify_pitr_pdb.sql" "$pdb_name" "$target_utc")
    clean_line=$(echo "$report_output" | grep "^AUDIT_RESULT|" | tr -d '\r')
    [ -n "$clean_line" ] || die "[${pdb_name}] Failed to retrieve PITR audit vector."

    log_info "Raw audit vector: ${clean_line}"

    local total_rows max_seq broken_links future_rows drift_sec
    total_rows=$(echo "$clean_line" | awk -F'|' '{print $3}' | cut -d= -f2)
    max_seq=$(echo "$clean_line" | awk -F'|' '{print $4}' | cut -d= -f2)
    broken_links=$(echo "$clean_line" | awk -F'|' '{print $5}' | cut -d= -f2)
    future_rows=$(echo "$clean_line" | awk -F'|' '{print $6}' | cut -d= -f2)
    drift_sec=$(echo "$clean_line" | awk -F'|' '{print $9}' | cut -d= -f2)

    [ "$total_rows" -gt 0 ] || die "[${pdb_name}] FAIL: Canary ledger table is empty (TOTAL_ROWS=0)."
    [ "$total_rows" -eq "$max_seq" ] || die "[${pdb_name}] FAIL: Sequence gap detected! TOTAL_ROWS (${total_rows}) != MAX_SEQ (${max_seq})."
    [ "$broken_links" -eq 0 ] || die "[${pdb_name}] FAIL: SHA-256 hash chain integrity compromised! Broken links: ${broken_links}."
    [ "$future_rows" -eq 0 ] || die "[${pdb_name}] FAIL: Future data leak detected! Found ${future_rows} rows after target UTC ${target_utc}."
    [ "$drift_sec" -ge 0 ] || die "[${pdb_name}] FAIL: Negative RPO drift (${drift_sec}s) — recovery rolled forward past target timestamp."
    [ "$drift_sec" -le "$MAX_RPO_DRIFT_SECONDS" ] || die "[${pdb_name}] FAIL: Excessive RPO drift! Latest row is ${drift_sec}s older than target (threshold: ${MAX_RPO_DRIFT_SECONDS}s)."

    log_info "[${pdb_name}] PASS: SHA-256 chain verified (${total_rows} links, 0 gaps, RPO drift: ${drift_sec}s prior to target)."
}

cmd_verify() {
    local target_utc="${1:-}"
    [ -n "$target_utc" ] || die "Verify command requires a target UTC timestamp ('YYYY-MM-DD HH24:MI:SS')."
    [[ "$target_utc" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] || die "Invalid timestamp format: '${target_utc}'. Expected: 'YYYY-MM-DD HH24:MI:SS'."

    log_info "Starting cryptographic PITR audit against target UTC: ${target_utc}"
    local pdb_name
    for pdb_name in "${PDB_LIST[@]}"; do
        verify_single_pdb "$pdb_name" "${PDB_STORAGE_MAP[$pdb_name]}" "$target_utc"
    done
    log_info "=== PITR AUDIT PASSED SUCCESSFULLY ACROSS ALL 3 PDB CONTAINERS ==="
}

main() {
    local action="${1:-}"
    [ -n "$action" ] || usage
    shift

    load_environment
    validate_prerequisites sqlplus awk grep cut aws

    case "$action" in
        init)    cmd_init "$@" ;;
        pulse)   cmd_pulse "$@" ;;
        inspect) cmd_inspect "$@" ;;
        verify)  cmd_verify "$@" ;;
        *)       usage ;;
    esac
}

main "$@"
