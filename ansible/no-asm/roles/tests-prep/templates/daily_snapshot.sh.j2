#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
[ -f "${SCRIPT_DIR}/lib_oracle_common.sh" ] || { echo "[CRITICAL] Missing ${SCRIPT_DIR}/lib_oracle_common.sh" >&2; exit 1; }
# shellcheck source=/home/oracle/scripts/lib_oracle_common.sh
source "${SCRIPT_DIR}/lib_oracle_common.sh"

readonly LOG_FILE="/tmp/oracle_daily_snapshot_$(date +%Y%m%d).log"
INSTANCE_ID=""
REGION=""

discover_aws_metadata() {
    log_info "Querying EC2 instance metadata via IMDSv2..."
    local token
    token=$(curl -s -f -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 60") || die "IMDSv2 token request failed."

    INSTANCE_ID=$(curl -s -f -H "X-aws-ec2-metadata-token: $token" \
        "http://169.254.169.254/latest/meta-data/instance-id") || die "Failed to retrieve INSTANCE_ID from IMDSv2."

    REGION=$(curl -s -f -H "X-aws-ec2-metadata-token: $token" \
        "http://169.254.169.254/latest/meta-data/placement/region") || die "Failed to retrieve REGION from IMDSv2."

    [ -n "$INSTANCE_ID" ] || die "Retrieved INSTANCE_ID is empty."
    [ -n "$REGION" ] || die "Retrieved REGION is empty."
    log_info "Runtime context discovered: INSTANCE_ID=${INSTANCE_ID}, REGION=${REGION}"
}

emergency_end_backup() {
    local exit_code=$?
    log_info "GUARD CLAUSE (TRAP): Executing emergency END BACKUP (exit_code=${exit_code})..."
    run_sql_quiet "db_lifecycle_op.sql" "END_BACKUP" || true
    exit "$exit_code"
}

enable_hot_backup() {
    log_info "Putting database ${ORACLE_SID} into BEGIN BACKUP mode..."
    run_sql_quiet "db_lifecycle_op.sql" "BEGIN_BACKUP"
    trap emergency_end_backup EXIT ERR SIGINT SIGTERM
}

trigger_ebs_snapshots() {
    log_info "Triggering crash-consistent EBS multi-volume snapshots for ${INSTANCE_ID}..."
    aws ec2 create-snapshots \
        --region "$REGION" \
        --instance-specification "InstanceId=${INSTANCE_ID},ExcludeBootVolume=true" \
        --description "App-Consistent Backup: ${ORACLE_SID} ($(date +%Y-%m-%d))" \
        --copy-tags-from-source volume >/dev/null
    log_info "EBS snapshot creation request accepted by AWS API."
}

disable_hot_backup() {
    log_info "Ending Hot Backup mode (END BACKUP) and archiving current Redo Log..."
    run_sql_quiet "db_lifecycle_op.sql" "END_BACKUP"
    trap - EXIT ERR SIGINT SIGTERM
}

main() {
    init_logging "$LOG_FILE"
    acquire_lock "daily_snapshot"
    load_environment
    validate_prerequisites sqlplus aws curl
    discover_aws_metadata
    enable_hot_backup
    trigger_ebs_snapshots
    disable_hot_backup
    log_info "Application-consistent EBS snapshot workflow completed successfully."
}

main "$@"
